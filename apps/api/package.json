{
  "name": "@katalyst/api",
  "version": "0.1.0",
  "private": true,
  "description": "API Fastify (/api/v1), proceso de control y visor de reportes de Katalyst",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source src/main.api.ts",
    "dev:control": "tsx watch --conditions=source src/main.control.ts",
    "dev:reports": "tsx watch --conditions=source src/main.reports.ts",
    "start": "node dist/main.api.js",
    "start:control": "node dist/main.control.js",
    "start:reports": "node dist/main.reports.js",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:test:deploy": "DATABASE_URL=$TEST_DATABASE_URL prisma migrate deploy",
    "bootstrap-admin": "tsx --conditions=source src/cli/bootstrap-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@aws-sdk/client-s3": "3.1163.0",
    "@aws-sdk/client-ssm": "3.1163.0",
    "@aws-sdk/s3-request-presigner": "3.1163.0",
    "@fastify/cookie": "catalog:",
    "@fastify/cors": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/rate-limit": "catalog:",
    "@fastify/swagger": "catalog:",
    "@fastify/swagger-ui": "catalog:",
    "@katalyst/shared": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "catalog:",
    "bullmq": "catalog:",
    "fastify": "catalog:",
    "fastify-plugin": "catalog:",
    "fastify-type-provider-zod": "catalog:",
    "ioredis": "catalog:",
    "nodemailer": "10.3.1",
    "pdfkit": "0.20.2",
    "pino": "catalog:",
    "prom-client": "15.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pdfkit": "0.17.7",
    "@vitest/coverage-v8": "catalog:",
    "pino-pretty": "catalog:",
    "prisma": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
