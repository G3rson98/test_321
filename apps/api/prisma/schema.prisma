// =============================================================================
// Katalyst (DeltaX QA Runner) — esquema PostgreSQL (ESP §7, §13, §17.4).
//
// Convenciones: tablas/columnas snake_case (@@map/@map), ids UUID, created_at/updated_at timestamptz(6),
// todos los instantes en UTC (timestamptz). Enums de PostgreSQL con los valores EXACTOS de
// packages/shared/src/enums.ts (verificado por test/migration.integration.test.ts).
// Sin borrado físico de casos, usuarios, tests, ambientes, programaciones ni suites referenciados por historial:
// archived_at / disabled_at / deleted_at / status=retirado.
//
// Excepción documentada: event_log usa `seq BIGSERIAL` como PK (es el `id` SSE / Last-Event-ID, plan §4.4).
//
// Restricciones escritas a mano en la migración (Prisma no puede expresarlas) — ver
// prisma/migrations/*_init/migration.sql, sección "KATALYST HAND-WRITTEN":
//   ux_worker_lease_active_per_shard     UNIQUE (run_shard_id) WHERE revoked_at IS NULL AND released_at IS NULL
//                                         → como máximo un lease vigente por shard (ESP §7, §13.3)
//   ux_test_attempt_running_per_result   UNIQUE (run_result_id) WHERE status = 'corriendo'
//                                         → un propietario activo por test/variante (ESP §7)
//   ux_run_active_per_schedule           UNIQUE (schedule_id) WHERE schedule_id IS NOT NULL AND status IN
//                                         (en_cola, preparando, corriendo, finalizando, cancelando)
//                                         → máx. una corrida activa o en cola por programación (RF-PRG-04)
//   ux_capacity_reservation_slot_active  UNIQUE (scope, scope_key, slot) WHERE released_at IS NULL
//   ux_capacity_reservation_shard_scope  UNIQUE (run_shard_id, scope) WHERE released_at IS NULL AND run_shard_id IS NOT NULL
//                                         → reserva atómica de capacidad/usuario (ESP §13.3, §13.5)
//   ux_panel_user_auth_subject           UNIQUE (auth_subject) WHERE auth_subject IS NOT NULL
//   ux_environment_name_active           UNIQUE (lower(name)) WHERE disabled_at IS NULL
//   ck_panel_user_email_lower            CHECK (email = lower(email))  (correos normalizados únicos)
//   ck_run_retries / ck_schedule_retries CHECK (retries BETWEEN 0 AND 2)
//   ck_test_attempt_no / ck_run_result_parameter_key
//   ck_exclusion_window_range            CHECK (ends_at > starts_at)
//   ck_perf_threshold_min_samples        piso de min_samples por métrica (p95/error_rate/timeout_rate ≥ 20, max ≥ 1)
//   ck_perf_sample_nonneg                duraciones/tamaños no negativos; timeout ⇒ total_ms NULL (censurado)
//   ck_perf_sample_censored_timeout      censored = timeout; ck_perf_sample_over_29s: over_29s ⇒ completada > 29 000 ms
//   ck_api_credential_principal          exactamente uno de principal_id (usuario) o service_name
//   ck_testrail_section_parent           parent_id ≠ id; misma suite vía FK compuesta (parent_id, suite_id) → (id, suite_id)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

