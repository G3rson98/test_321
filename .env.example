# =============================================================================
# Katalyst — variables de entorno de ejemplo (API, control, visor de reportes y runner).
# Valores DUMMY. Nunca poner secretos reales aquí (RNF-SEG-01). Los secretos se leen por REFERENCIA
# (`*_REF` = env:NOMBRE | file:/ruta | ssm:/prefijo/nombre) mediante SecretProvider (plan §3).
# Con SECRET_PROVIDER=env, la referencia env:KATALYST_SECRET__X se resuelve leyendo la variable
# KATALYST_SECRET__X, que se define SOLO en tu entorno local (.env ignorado por git), nunca en este archivo.
# Validación: apps/api/src/config.ts (Zod) y apps/runner/src/config.ts.
# =============================================================================

# --- General ---
# development | test | production
NODE_ENV=development
# Nivel de log pino
LOG_LEVEL=info
# Versión reportada en /healthz
SERVICE_VERSION=0.1.0
# Zona IANA de presentación y programaciones (RNF-USA-01)
DEFAULT_TIMEZONE=America/La_Paz

# --- API HTTP (apps/api src/main.api.ts) y visor de reportes (src/main.reports.ts) ---
# Interfaz de escucha de la API
API_HOST=0.0.0.0
# Puerto de la API (/api/v1, /healthz, /readyz)
API_PORT=3000
# Interfaz del visor de reportes
REPORTS_HOST=0.0.0.0
# Puerto del visor de reportes (origen separado)
REPORTS_PORT=3001
# URL pública del panel (enlaces autenticados en TestRail/notificaciones)
PUBLIC_BASE_URL=http://localhost:5173
# URL del origen separado de reportes HTML
REPORTS_BASE_URL=http://localhost:3001
# Confiar en X-Forwarded-* (detrás de Caddy)
TRUST_PROXY=false
# Límite de cuerpo HTTP (grabación ≤ 1 MiB + margen)
BODY_LIMIT_BYTES=1114112
# Servir Swagger UI en /api/docs
OPENAPI_UI_ENABLED=true
# Orígenes CORS permitidos separados por coma; vacío = cerrado (mismo origen)
CORS_ALLOWED_ORIGINS=
# Solicitudes por ventana y cliente
RATE_LIMIT_MAX=300
# Ventana de rate limit (ms)
RATE_LIMIT_WINDOW_MS=60000

# --- PostgreSQL (pool total de todos los procesos ≤ 20, RNF-OPT-05) ---
# Alternativa en deploy: DATABASE_URL_FILE=/run/secrets/database_url y REDIS_URL_FILE=... (se leen si la variable
# directa no está definida; docs/pendientes-integracion.md).
# URL PostgreSQL (sin credenciales reales en el repo)
DATABASE_URL=postgresql://katalyst:katalyst_dev@localhost:5432/katalyst
# connection_limit del proceso API
DATABASE_POOL_API=10
# connection_limit del proceso control
DATABASE_POOL_CONTROL=6
# connection_limit del visor de reportes
DATABASE_POOL_REPORTS=3
# Override del pool del proceso actual (docker-compose lo fija por servicio); vacío = usar DATABASE_POOL_<PROCESO>
DATABASE_POOL_MAX=
# Presupuesto total de conexiones (≤ 20, RNF-OPT-05)
TOTAL_DB_POOL_BUDGET=20
# pool_timeout de Prisma (s)
DB_POOL_TIMEOUT_SECONDS=10

# --- Redis / BullMQ (transporte reconstruible) ---
# URL Redis (BullMQ)
REDIS_URL=redis://localhost:6379/0
# Prefijo de colas BullMQ
QUEUE_PREFIX=katalyst

# --- Sesión del panel (RF-USR-01, ESP §13.7) ---
# Nombre de la cookie de sesión HttpOnly
SESSION_COOKIE_NAME=katalyst_session
# Duración de sesión del panel (h)
SESSION_TTL_HOURS=12
# Referencia al secreto de firma de cookies [referencia a secreto]
SESSION_SECRET_REF=env:KATALYST_SECRET__SESSION
# Cookies Secure (false solo en loopback de desarrollo)
COOKIE_SECURE=false
# Encabezado del token CSRF
CSRF_HEADER_NAME=x-csrf-token
# Correo del administrador inicial
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Referencia a la contraseña inicial del administrador [referencia a secreto]
BOOTSTRAP_ADMIN_PASSWORD_REF=env:KATALYST_SECRET__BOOTSTRAP_ADMIN_PASSWORD

# --- OIDC corporativo opcional (pendiente ESP §12) ---
# Issuer OIDC corporativo (opcional)
OIDC_ISSUER_URL=
# Client ID OIDC (opcional)
OIDC_CLIENT_ID=
# Referencia al client secret OIDC [referencia a secreto]
OIDC_CLIENT_SECRET_REF=env:KATALYST_SECRET__OIDC_CLIENT_SECRET
# Redirect URI OIDC
OIDC_REDIRECT_URL=

# --- Proveedor de secretos (plan §3: env | file | ssm) ---
# env | file | ssm
SECRET_PROVIDER=env
# Directorio para SECRET_PROVIDER=file
SECRET_FILE_DIR=/run/secrets/katalyst
# Región AWS (pendiente ESP §12)
AWS_REGION=
# Prefijo de SSM Parameter Store
SSM_PREFIX=/katalyst/internal

# --- Artefactos (S3 privado; MinIO/fs solo dev; RNF-SEG-05) ---
# fs | s3 | minio
ARTIFACT_STORE=fs
# Bucket privado de evidencia
ARTIFACT_BUCKET=katalyst-evidence
# Directorio local de artefactos (dev)
ARTIFACT_FS_DIR=./.data/artifacts
# Referencia a la clave HMAC de URLs firmadas del almacén fs (dev; vacío = derivada de SESSION_SECRET_REF) [referencia a secreto]
ARTIFACT_FS_SIGNING_KEY_REF=
# Endpoint S3 compatible (MinIO dev)
S3_ENDPOINT=http://localhost:9000
# Referencia a access key (solo MinIO dev; en AWS usar instance profile) [referencia a secreto]
S3_ACCESS_KEY_REF=env:KATALYST_SECRET__MINIO_ACCESS_KEY
# Referencia a secret key (solo MinIO dev) [referencia a secreto]
S3_SECRET_KEY_REF=env:KATALYST_SECRET__MINIO_SECRET_KEY
# Vigencia de URLs firmadas (máx. 300, RNF-SEG-05)
SIGNED_URL_TTL_SECONDS=300

# --- TestRail (bootstrap; la conexión vigente se administra en BD, RF-TR-01) ---
# URL de TestRail (bootstrap; la conexión se administra en BD)
TESTRAIL_BASE_URL=https://example.testrail.io
# Usuario de servicio TestRail (bootstrap)
TESTRAIL_USERNAME=qa-runner@example.com
# Referencia a la API key de TestRail [referencia a secreto]
TESTRAIL_API_KEY_REF=env:KATALYST_SECRET__TESTRAIL_API_KEY
# Intervalo de sincronización (ms, default 1 h)
TESTRAIL_SYNC_INTERVAL_MS=3600000

# --- Plataforma Git para PR de grabaciones (pendiente ESP §12) ---
# github | gitlab | none (pendiente ESP §12)
GIT_PROVIDER=none
# URL API de la plataforma Git
GIT_BASE_URL=https://api.github.com
# Repositorio de tests (owner/repo)
GIT_REPOSITORY=deltax/qa-tests
# Rama protegida con el manifiesto aprobado
GIT_PROTECTED_BRANCH=main
# Referencia al token del adaptador que abre PR (sin permiso de merge) [referencia a secreto]
GIT_TOKEN_REF=env:KATALYST_SECRET__GIT_TOKEN

# --- Notificaciones (canal pendiente ESP §12) ---
# Canales habilitados: correo,slack,teams (pendiente ESP §12)
NOTIFIER_CHANNELS=
# Servidor SMTP
SMTP_HOST=smtp.example.com
# Puerto SMTP
SMTP_PORT=587
# Remitente
SMTP_FROM=katalyst@example.com
# Referencia a credenciales SMTP [referencia a secreto]
SMTP_CREDENTIALS_REF=env:KATALYST_SECRET__SMTP
# Referencia al webhook de Slack [referencia a secreto]
SLACK_WEBHOOK_REF=env:KATALYST_SECRET__SLACK_WEBHOOK
# Referencia al webhook de Teams [referencia a secreto]
TEAMS_WEBHOOK_REF=env:KATALYST_SECRET__TEAMS_WEBHOOK

# --- IA (proveedor pendiente ESP §12; presupuesto obligatorio antes de llamar) ---
# none | anthropic (pendiente ESP §12)
AI_PROVIDER=none
# Modelo configurable del proveedor
AI_MODEL=
# Referencia a la API key del proveedor IA [referencia a secreto]
AI_API_KEY_REF=env:KATALYST_SECRET__AI_API_KEY
# Presupuesto máximo por solicitud (USD)
AI_BUDGET_USD_PER_REQUEST=0.5
# Presupuesto por usuario y día (USD)
AI_BUDGET_USD_PER_USER_DAY=5
# Presupuesto mensual total (USD)
AI_BUDGET_USD_PER_MONTH=50
# Timeout por solicitud IA (ms)
AI_TIMEOUT_MS=120000

# --- Grabación, IA, notificaciones, exportaciones y rendimiento (API-C, D-031) ---
# Override del proveedor de PR de grabaciones: github | gitlab | local | none (vacío = GIT_PROVIDER)
GIT_PR_PROVIDER=
# Repositorio git local para PR de grabaciones (solo dev)
GIT_PR_LOCAL_REPO_PATH=
# Carpeta de tests grabados en el repositorio de tests
RECORDING_TESTS_DIR=tests/grabaciones
# Carpeta de borradores generados por IA
AI_DRAFTS_DIR=tests/borradores
# Módulo de fixtures que importa cada test generado
QA_TESTS_FIXTURE_IMPORT=../../fixtures/test.ts
# URL de descarga del asistente local (Windows 11)
RECORDER_INSTALL_URL=
# Ruta del panel para aprobar dispositivos
DEVICE_VERIFICATION_PATH=/dispositivos/vincular
# Vigencia de la credencial del asistente (días)
DEVICE_CREDENTIAL_TTL_DAYS=90
# Ventana para considerar en línea al asistente (s)
DEVICE_ONLINE_WINDOW_SECONDS=120
# Permite webhooks loopback/http (solo dev/pruebas)
NOTIFIER_WEBHOOK_ALLOW_LOOPBACK=false
# Esfuerzo del modelo IA: low | medium | high
AI_EFFORT=medium
# Máximo de tokens de salida por solicitud IA
AI_MAX_OUTPUT_TOKENS=16000
# Precio USD por millón de tokens de entrada/salida (presupuesto; vacío = sin precio configurado)
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
# Vencimiento de archivos de exportación (h)
EXPORT_TTL_HOURS=24
# Retención de muestras crudas / agregados de rendimiento (días)
PERF_RAW_RETENTION_DAYS=90
PERF_AGGREGATE_RETENTION_DAYS=365
# Minutos sin datos para marcar un hueco en series
PERF_GAP_THRESHOLD_MIN=15

# --- Proceso de control (apps/api src/main.control.ts; ESP §13.3, §13.5, §13.8) ---
# Tick del planificador (≤ 15000)
SCHEDULER_TICK_MS=15000
# Intervalo del reconciliador de ocurrencias
RECONCILER_INTERVAL_MS=60000
# Intervalo del publicador de outbox
OUTBOX_POLL_MS=5000
# Watchdog de leases (≤ 15000)
WATCHDOG_INTERVAL_MS=15000
# Expiración de lease desde último heartbeat (75000)
LEASE_TTL_MS=75000
# Heartbeat del ejecutor (15000)
HEARTBEAT_INTERVAL_MS=15000
# Evaluador de umbrales (60000)
THRESHOLD_EVAL_INTERVAL_MS=60000
# Hora UTC de la limpieza diaria
CLEANUP_HOUR_UTC=8
# Navegadores concurrentes globales (1 inicial)
GLOBAL_BROWSER_CONCURRENCY=1
# Archivo cuyo mtime actualiza el proceso de control en cada ciclo (healthcheck); vacío = deshabilitado
HEALTH_FILE=/tmp/health/alive

# --- Seguridad de red (allowlist SSRF, ESP §13.7) y supervisor ---
# Allowlist de hosts de ambientes/TestRail (SSRF), separados por coma
ALLOWED_TARGET_HOSTS=staging.deltax.example,example.testrail.io
# Referencia al token de servicio del supervisor [referencia a secreto]
SUPERVISOR_TOKEN_REF=env:KATALYST_SECRET__SUPERVISOR_TOKEN

# --- Valores de secretos para SECRET_PROVIDER=env (solo desarrollo local) ---
# Definirlos en tu shell o en un .env local ignorado por git; NUNCA aquí con valores reales.
# KATALYST_SECRET__SESSION=<definir-localmente>
# KATALYST_SECRET__BOOTSTRAP_ADMIN_PASSWORD=<definir-localmente>
# KATALYST_SECRET__SUPERVISOR_TOKEN=<definir-localmente>
# KATALYST_SECRET__TESTRAIL_API_KEY=<definir-localmente>
# KATALYST_SECRET__MINIO_ACCESS_KEY=<definir-localmente>
# KATALYST_SECRET__MINIO_SECRET_KEY=<definir-localmente>

# --- Pruebas (Vitest de apps/api) ---
# BD y Redis reales para contratos críticos (ESP §14).
TEST_DATABASE_URL=postgresql://katalyst:katalyst_dev@localhost:5432/katalyst_test
TEST_REDIS_URL=redis://localhost:6379/15

# --- Runner: supervisor del host y ejecutor de shard (apps/runner; plan §3, §4.3) ---
# Propuesta de contrato; el agente del runner la valida en apps/runner/src/config.ts.
# URL de la API de worker para supervisor (token de servicio) y ejecutor (token de lease); en deploy apunta al
# gateway interno http://worker-gw:8081 (docs/pendientes-integracion.md). El ejecutor no accede a BD/Redis.
# Ojo: KATALYST_API_URL está reservado para la URL de la API de DeltaX que qa-tests recibe del runner.
KATALYST_WORKER_API_URL=http://localhost:3000
# Identificador estable del host supervisor (correlación corrida/shard/contenedor)
RUNNER_WORKER_ID=host-local-1
# Cola BullMQ consumida por el supervisor (solo transporta { runId, shardId })
RUNNER_QUEUE_NAME=run-shards
# Contenedores/procesos ejecutores simultáneos; debe ser ≤ GLOBAL_BROWSER_CONCURRENCY (1 inicial)
RUNNER_MAX_EXECUTORS=1
# docker (producción: imagen oficial Playwright fijada por tag+digest) | process (solo desarrollo local)
RUNNER_EXECUTOR_MODE=process
# Imagen del ejecutor: misma versión exacta que @playwright/test de qa-tests (nunca latest)
RUNNER_PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.65.0-noble
RUNNER_PLAYWRIGHT_IMAGE_DIGEST=
# Directorio temporal por ejecución (tmpfs en el host) para secretos montados y storageState; se borra al terminar
RUNNER_TMP_DIR=/tmp/katalyst-runner
# Caché local de checkouts por commit SHA del repositorio qa-tests (solo commits permitidos)
RUNNER_REPO_CACHE_DIR=./.data/qa-tests-cache
# Cuotas por corrida (ARQ §6): 250 MiB evidencia, 1 GiB temporal
RUNNER_MAX_EVIDENCE_BYTES=262144000
RUNNER_MAX_TEMP_BYTES=1073741824
