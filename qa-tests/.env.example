# Variables de qa-tests (ejemplo sin secretos). El runner de Katalyst las fija por asignación.
# Las credenciales NO van aquí: se leen de un archivo JSON montado en tmpfs (KATALYST_TEST_USER_FILE).

# Ambiente (RF-AMB-01). Un project de Playwright por ambiente.
KATALYST_ENV_NAME=staging
KATALYST_APP_URL=https://staging.app.example.test
KATALYST_API_URL=https://staging.api.example.test
# Fail-safe: si se omite, el ambiente se trata como producción. Hosts productivos conocidos siempre son producción.
KATALYST_ENV_IS_PRODUCTION=false
KATALYST_ENVIRONMENT_ID=
KATALYST_RUN_ID=local-001

# Sesión y usuario de prueba (RF-AMB-02/03). Rutas FUERA del repositorio (tmpfs en el worker).
KATALYST_STORAGE_STATE_PATH=/tmp/katalyst/storageState.json
KATALYST_TEST_USER_FILE=/run/katalyst/secrets/test-user.json
KATALYST_EXPECTED_USERNAME=

# Datos sintéticos esperados por pantalla (fixtures/perfiles.ts): default | staging-sembrado
KATALYST_FIXTURE_PROFILE=default

# Ejecución
KATALYST_RETRIES=0
KATALYST_WORKERS=1
# Política de artefactos (ESP §13.7). Producción: todo off salvo sanitizationVerified=true.
KATALYST_ARTIFACT_POLICY={"trace":"off","video":"off","screenshot":"only-on-failure"}

# Reportes (rutas relativas a qa-tests o absolutas)
KATALYST_OUTPUT_DIR=test-results
KATALYST_REPORT_HTML_DIR=playwright-report/html
KATALYST_REPORT_JSON_FILE=playwright-report/results.json
KATALYST_REPORT_JUNIT_FILE=playwright-report/junit.xml

# Rendimiento (@rendimiento)
KATALYST_PERF_OUTPUT_DIR=
KATALYST_PERF_CYCLE_BUDGET_MS=200000
KATALYST_DXMON_CYCLE_MS=90000
KATALYST_PERF_MAX_LOAD_PER_CPU=1.5
KATALYST_WORKER_PROFILE=
