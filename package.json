{
  "name": "katalyst",
  "private": true,
  "description": "Katalyst (DeltaX QA Runner) — monorepo",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.22.2 <25",
    "pnpm": ">=10.34.9 <11"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "pnpm -r --if-present run coverage",
    "db:migrate": "pnpm --filter @katalyst/api run db:migrate",
    "db:generate": "pnpm --filter @katalyst/api run db:generate",
    "secrets:scan": "gitleaks detect --no-git --source . --config .gitleaks.toml --redact",
    "secrets:scan:git": "gitleaks git --config .gitleaks.toml --redact .",
    "dev:stack": "scripts/dev-stack.sh start",
    "dev:stack:stop": "scripts/dev-stack.sh stop",
    "dev:stack:status": "scripts/dev-stack.sh status",
    "dev:seed": "node scripts/seed-dev.ts",
    "dev:e2e": "node scripts/e2e-local.ts",
    "accept:canarios": "node scripts/aceptacion-canarios.ts",
    "load:seed": "node scripts/load/seed-5000.ts",
    "load:run": "node scripts/load/run-load.ts",
    "load:explain": "node --conditions=source --import ./apps/api/node_modules/tsx/dist/loader.mjs scripts/load/explain-queries.ts",
    "backup:local": "scripts/backup-restore-local.sh"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
