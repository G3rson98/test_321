# Katalyst — ejemplo de variables del bootstrap. Copiar a terraform.tfvars (no versionar).
# Sin secretos: solo identificadores. Valores PENDIENTES de decisión ESP §12.

aws_region     = "PENDIENTE-region"   # p. ej. us-east-1 (PENDIENTE)
aws_account_id = "000000000000"       # cuenta AWS existente (PENDIENTE)
owner          = "PENDIENTE-equipo-qa"
cost_center    = "PENDIENTE-centro-de-costo"

# state_bucket_name          = "katalyst-tfstate-000000000000-us-east-1"
# state_kms_key_arn          = "arn:aws:kms:us-east-1:000000000000:key/00000000-0000-0000-0000-000000000000"
# state_admin_principal_arns = ["arn:aws:iam::000000000000:role/aws-reserved/sso.amazonaws.com/*AdministratorAccess*"]
