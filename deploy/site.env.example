# Katalyst — ajustes NO secretos propios del sitio (copiar a /etc/katalyst/site.env en el host).
# Requisitos: ESP §13.7 (staging privado explícitamente permitido es excepción registrada), ARQ §4.

# Correo de registro ACME (Let's Encrypt u otra CA ACME), no secreto.
ACME_EMAIL=PENDIENTE@example.com

# Excepciones privadas para ejecutores (separadas por espacio). Vacío por defecto: los tests solo
# alcanzan destinos públicos. Cada excepción debe registrarse en docs/decisiones.md.
RUNNER_PRIVATE_ALLOW_CIDRS=

# Subredes Docker (cambiar solo si se solapan con allowed_cidrs, la VPC o redes corporativas).
# KATALYST_NET_EDGE_SUBNET=172.30.0.0/24
# KATALYST_NET_DB_SUBNET=172.30.1.0/24
# KATALYST_NET_RUNNER_SUBNET=172.30.2.0/24
# KATALYST_NET_QUEUE_SUBNET=172.30.3.0/24
# KATALYST_WORKER_GW_IP=172.30.2.10
