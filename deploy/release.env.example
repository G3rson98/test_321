# Katalyst — manifiesto de una versión desplegada (copiar como /opt/katalyst/releases/<versión>/release.env).
# Requisitos: ESP §4 (imágenes fijadas por tag y digest, sin latest), ESP §13.1 (versiones de runtime),
# ESP §18 (rollback). NO contiene secretos. Lo genera el pipeline de aplicación (CI) por cada versión.
# Registro de imágenes PENDIENTE (depende de la plataforma Git, ESP §12): p. ej. ghcr.io/<org> o registry.gitlab.com/<grupo>.

KATALYST_VERSION=0.0.0-PENDIENTE
KATALYST_GIT_COMMIT=0000000000000000000000000000000000000000

KATALYST_API_IMAGE=REGISTRO/katalyst-api:0.0.0@sha256:PENDIENTE
KATALYST_RUNNER_IMAGE=REGISTRO/katalyst-runner:0.0.0@sha256:PENDIENTE
KATALYST_WEB_IMAGE=REGISTRO/katalyst-web:0.0.0@sha256:PENDIENTE
# Base: mcr.microsoft.com/playwright:v<PLAYWRIGHT_VERSION>-noble@sha256:<digest>; misma versión exacta
# que @playwright/test en apps/runner y qa-tests.
KATALYST_EXECUTOR_IMAGE=REGISTRO/katalyst-executor:0.0.0@sha256:PENDIENTE
KATALYST_PLAYWRIGHT_VERSION=1.5x.y-PENDIENTE

POSTGRES_IMAGE=postgres:16.x-bookworm@sha256:PENDIENTE
REDIS_IMAGE=redis:7.x-bookworm@sha256:PENDIENTE
