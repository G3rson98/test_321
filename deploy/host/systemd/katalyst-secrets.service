# Katalyst — secretos del host desde SSM a tmpfs (RNF-SEG-01, ESP §18).
[Unit]
Description=Katalyst: materializar secretos del host desde SSM SecureString
After=network-online.target
Wants=network-online.target
Before=katalyst.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/katalyst/current/deploy/scripts/sync-secrets.sh
StandardOutput=append:/var/log/katalyst/sync-secrets.log
StandardError=append:/var/log/katalyst/sync-secrets.log

[Install]
WantedBy=multi-user.target
