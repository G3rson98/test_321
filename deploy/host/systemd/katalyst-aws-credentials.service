# Katalyst — broker de credenciales temporales del rol (RNF-SEG-05, ARQ §4).
[Unit]
Description=Katalyst: credenciales temporales del rol para servicios confiables
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/katalyst/current/deploy/scripts/aws-credential-broker.sh
StandardOutput=append:/var/log/katalyst/aws-credential-broker.log
StandardError=append:/var/log/katalyst/aws-credential-broker.log
